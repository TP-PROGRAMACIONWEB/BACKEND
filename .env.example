DATABASE_URL=sqlite:///./offix_dev.db
SECRET_KEY=change-me
ACCESS_TOKEN_EXPIRE_MINUTES=60
CORS_ORIGINS=http://localhost:3000

# URL base del frontend: se usa para armar los links que viajan por correo.
FRONTEND_URL=http://localhost:3000

# Brevo — envío de correos transaccionales.
# La API key se saca del panel de Brevo (SMTP & API > API Keys).
# El remitente tiene que ser una dirección verificada en la cuenta de Brevo.
BREVO_API_KEY=
BREVO_SENDER_EMAIL=no-reply@offix.example.com
BREVO_SENDER_NAME=Offix
