# Base de datos. Dejar activa UNA de las dos líneas.
#
# 1) SQLite local, para desarrollo y pruebas (no necesita red):
DATABASE_URL=sqlite:///./offix_dev.db
#
# 2) PostgreSQL en la nube (Supabase), para el despliegue. Copiar la URI del
#    panel (Project Settings > Database > Connection string > Session pooler).
#    La contraseña va URL-encodeada: $ -> %24, # -> %23, espacio -> %20.
#    SSL se exige automáticamente; no hace falta agregar ?sslmode=require.
#    Las tablas van al schema DATABASE_SCHEMA, y se crean/modifican SOLO con
#    migraciones: correr migrar_bd.bat antes de levantar el backend.
# DATABASE_URL=postgresql://USUARIO:CONTRASENA_ENCODEADA@aws-0-us-east-2.pooler.supabase.com:5432/postgres
# DATABASE_SCHEMA=offix

SECRET_KEY=change-me
ACCESS_TOKEN_EXPIRE_MINUTES=60
CORS_ORIGINS=http://localhost:3000

# URL base del frontend: se usa para armar los links que viajan por correo.
FRONTEND_URL=http://localhost:3000

# Brevo — envío de correos transaccionales.
# La API key se saca del panel de Brevo (SMTP & API > API Keys).
# El remitente tiene que ser una dirección verificada en la cuenta de Brevo.
BREVO_API_KEY=
BREVO_SENDER_EMAIL=no-reply@offix.example.com
BREVO_SENDER_NAME=Offix

# Prefijo internacional para armar el link de wa.me (Argentina móvil). El
# usuario carga los 10 dígitos de código de área + línea y el backend antepone
# este prefijo.
WHATSAPP_PREFIJO_PAIS=549

# Vencimiento del enlace de reseña, en días desde la generación.
SOLICITUD_RESENA_DIAS_VALIDEZ=7

# Matrícula trampa del CA03 de HU-02 (9999999999 para Gasista, 999999999 para
# Aire acondicionado): devuelve Timeout al instante, para que QA pueda probarlo.
# Poner en false en producción.
MATRICULA_TRAP_HABILITADA=true

# Auth0 — login con Google (HU-03, CA01-CA04). Convive con /auth/registro y
# /auth/login (email + password), que no cambian.
#
# El tenant tiene que estar creado como "Regular Web Application" (no SPA):
# el backend usa el client_secret para cambiar el code por el token, el
# frontend nunca lo ve. Pasos en el dashboard de Auth0:
#   1) Applications > Create Application > Regular Web Application.
#   2) Connections > Social > activar Google (google-oauth2).
#   3) En la Application: Allowed Callback URLs = el mismo valor que
#      AUTH0_CALLBACK_URL de abajo (tiene que coincidir exacto).
#   4) Copiar Domain, Client ID y Client Secret de la pestaña Settings.
#
# Sin estas tres variables, GET /auth/google/login responde 503 y el login
# por email/password sigue funcionando igual.
AUTH0_DOMAIN=
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=
# Tiene que ser exactamente la que está cargada en Auth0 (paso 3). Cambia
# entre entornos: localhost en desarrollo, el dominio real en producción.
AUTH0_CALLBACK_URL=http://localhost:8000/api/v1/auth/google/callback

# A dónde redirige el backend en el FRONTEND al terminar el flujo de Google.
# Éxito: {FRONTEND_URL}{GOOGLE_LOGIN_RUTA_EXITO}?token=<jwt>.
# Falla (CA03): {FRONTEND_URL}{GOOGLE_LOGIN_RUTA_ERROR}?error=auth_failed.
GOOGLE_LOGIN_RUTA_EXITO=/auth/callback
GOOGLE_LOGIN_RUTA_ERROR=/login
